# Cambia "tudominio.com" por tu dominio real.
# Caddy pedirá y renovará el certificado HTTPS automáticamente.
# Mientras no tengas dominio, puedes usar ":80" en lugar del dominio para probar por IP.

tudominio.com, www.tudominio.com {
	root * /srv
	encode zstd gzip
	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
