# Copia este archivo como .env en el VPS (cp .env.example .env) y rellena los valores.
# El .env NO se sube a GitHub (está en .gitignore).

# Dominio principal de la web (sin https://)
DOMINIO=tudominio.com

# Email para avisos de Let's Encrypt sobre los certificados
EMAIL_ACME=tu-correo@ejemplo.com

# Contraseña de la base de datos de Umami. Genera una con:  openssl rand -base64 32
UMAMI_DB_PASSWORD=cambia-esto

# Secreto de Umami. Genera uno con:  openssl rand -hex 32
UMAMI_APP_SECRET=cambia-esto
