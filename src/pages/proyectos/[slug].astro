---
import ProyectoDetalle from '../../views/ProyectoDetalle.astro';
import { getProyectos } from '../../lib/proyectos';

export async function getStaticPaths() {
  const proyectos = await getProyectos('es');
  return proyectos.map((proyecto) => ({ params: { slug: proyecto.slug }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
---
<ProyectoDetalle lang="es" proyecto={proyecto} />
