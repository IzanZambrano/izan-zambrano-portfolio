---
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { titulo, descripcion, tecnologias, fecha } = proyecto.data;
---

<article class="card">
  <a href={`/proyectos/${proyecto.id}/`} class="card-link">
    <p class="card-fecha">{fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}</p>
    <h3>{titulo}</h3>
    <p>{descripcion}</p>
    <ul class="tags">
      {tecnologias.map((t) => <li>{t}</li>)}
    </ul>
  </a>
</article>
